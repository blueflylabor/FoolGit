#!/usr/bin/env python3
"""
FoolGit - 傻瓜式 Git 助手
专为日常高频 Git 操作定制的极简命令行工具。
"""

import sys
import os

# 将当前脚本所在目录加入模块搜索路径，确保可以直接运行
CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
if CURRENT_DIR not in sys.path:
    sys.path.insert(0, CURRENT_DIR)

from foolgit_pkg.cli import FoolGitCLI


def main():
    target_dir = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else "."
    
    # 简单的参数支持
    if "-v" in sys.argv or "--version" in sys.argv:
        from foolgit_pkg import __version__
        print(f"FoolGit version {__version__}")
        sys.exit(0)

    if "-h" in sys.argv or "--help" in sys.argv:
        print("FoolGit - 傻瓜式定制 Git 助手 / Simple & Foolproof Git Assistant")
        print("用法 / Usage: foolgit [路径] [选项]")
        print("选项 / Options:")
        print("  -g, --gui      启动极简桌面图形界面 / Launch lightweight desktop GUI")
        print("  -v, --version  显示版本号 / Show version")
        print("  -h, --help     显示此帮助信息 / Show this help")
        print("\n直接运行 foolgit 即可进入交互式终端选择界面。")
        sys.exit(0)

    if "-g" in sys.argv or "--gui" in sys.argv:
        try:
            import PyQt6
        except ImportError:
            candidate_pythons = [
                "/opt/homebrew/Caskroom/miniconda/base/envs/playground/bin/python",
                os.path.expanduser("~/miniconda3/envs/playground/bin/python"),
                os.path.expanduser("~/.conda/envs/playground/bin/python"),
            ]
            for py_bin in candidate_pythons:
                if os.path.exists(py_bin):
                    os.execv(py_bin, [py_bin] + sys.argv)
        from foolgit_pkg.gui import launch_gui
        launch_gui(target_dir=target_dir)
        sys.exit(0)

    cli = FoolGitCLI(target_dir=target_dir)
    cli.run()


if __name__ == "__main__":
    main()
